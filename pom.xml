<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.platinumcoin</groupId>
  <artifactId>ciclo-de-cobranca</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>ciclo-de-cobranca</name>
  <description>Ciclo diário de cobrança contra parceiro por arquivo, com um lançamento contábil por fatura paga</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <aws.sdk.version>2.28.29</aws.sdk.version>
    <testcontainers.version>1.21.3</testcontainers.version>
    <junit.version>5.10.2</junit.version>
    <postgresql.version>42.7.4</postgresql.version>
    <slf4j.version>2.0.13</slf4j.version>
    <sshj.version>0.38.0</sshj.version>
    <spring.boot.version>3.5.3</spring.boot.version>
    <exec.mainClass>com.platinumcoin.ciclo.Main</exec.mainClass>

    <!-- Versão da API do daemon Docker usada pelo Testcontainers.
         O docker-java negocia uma versão antiga por padrão, e daemons recentes
         (Docker 25+) respondem 400 a ela. Fixar aqui é o que faz `mvn test`
         rodar sem variável de ambiente. Daemon mais antigo: sobrescreva com
         `mvn test -Ddocker.api.version=1.41`. -->
    <docker.api.version>1.44</docker.api.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Teto de infra: Postgres + SQS + S3 (LocalStack) + SFTP. Nada além, e
         não sobe de novo sem ADR — o S3 entrou pelo ADR-0003. Clientes
         avulsos, e não o bundle: o bundle traz o SDK inteiro. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <!-- SSH de verdade contra o container atmoz/sftp: o canal do parceiro é
         I/O, e um Path local fingindo de canal não teria latência nem arquivo
         aparecendo pela metade — ver docs/steps/step-08.md. -->
    <dependency>
      <groupId>com.hierynomus</groupId>
      <artifactId>sshj</artifactId>
      <version>${sshj.version}</version>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>

    <!-- O Spring Boot entra no step-10, e por um motivo só: o projeto passa a
         expor HTTP. Web e nada mais — a persistência continua JDBC puro, sem
         starter de dados, sem pool e sem ORM. O logging do starter fica de
         fora: o binding do projeto é o slf4j-simple do step-08, e dois
         bindings no classpath é um aviso a cada execução.
         DECISÃO: um único Spring Boot, e só por HTTP — ver docs/steps/step-10.md -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>localstack</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Os nomes dos parâmetros no bytecode. Sem isto, o Spring não sabe
               que `@RequestParam int quantidade` se chama "quantidade" e recusa
               toda chamada com 400. As rotas nomeiam os seus parâmetros à mão
               de qualquer forma; esta linha é o cinto além do suspensório. -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <!-- `mvn compile exec:java` roda o cenário do step-06 contra o ambiente do
           docker-compose. A classe vem da propriedade exec.mainClass, e a versão
           está fixada porque um plugin sem versão é uma build que muda sozinha. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
      <!-- `mvn spring-boot:run` sobe a API do step-10 contra o ambiente do
           docker-compose. Sem execução de `repackage` ligada: o artefato deste
           projeto continua sendo um jar comum. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <mainClass>com.platinumcoin.ciclo.AplicacaoHttp</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <api.version>${docker.api.version}</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- WSL2 com Docker Desktop sem a integração WSL habilitada: o daemon só é
         alcançável por este socket. O perfil se ativa sozinho quando o socket
         existe e é inerte em Linux nativo, macOS ou WSL com integração ligada.
         Sem isso, `mvn test` exigiria exportar DOCKER_HOST à mão — e a
         Definition of Done do step-01 diz que não exige. -->
    <profile>
      <id>wsl-docker-desktop</id>
      <activation>
        <file>
          <exists>/mnt/wsl/docker-desktop-bind-mounts/Ubuntu/docker.sock</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <environmentVariables>
                <DOCKER_HOST>unix:///mnt/wsl/docker-desktop-bind-mounts/Ubuntu/docker.sock</DOCKER_HOST>
                <!-- Ryuk monta o socket do daemon; dentro do container o caminho
                     é o do host, não o do WSL. -->
                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
              </environmentVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
